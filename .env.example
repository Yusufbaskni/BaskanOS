# Önerilen: Cursor hesabın
# Cursor → Settings / Dashboard → API Keys
CURSOR_API_KEY=

# Cursor model (varsayılan composer-2.5)
BASKANOS_CURSOR_MODEL=composer-2.5

# Alan bazlı override (opsiyonel)
# BASKANOS_CURSOR_MODEL_ENGINEERING=composer-2.5
# BASKANOS_CURSOR_MODEL_PRODUCT=composer-2.5

# Yerel kilit (opsiyonel). Boş bırakırsan PIN sorulmaz.
# BASKANOS_PIN=1234

# Veri klasörü (opsiyonel)
# BASKANOS_DATA_DIR=
# BASKANOS_DEFAULT_CWD=/path/to/repo

# İsteğe bağlı yedek: OpenAI uyumlu API
# BASKANOS_API_KEY=
# BASKANOS_API_BASE=https://api.openai.com/v1
# BASKANOS_MODEL=gpt-4o-mini
